#!/usr/bin/env python3
"""
Jarvis entry point.

This is invoked fresh by a Cinnamon keyboard shortcut - it is NOT a
background daemon. It runs, does one request, tells Ollama to unload
itself shortly after (keep_alive in config.yaml), and exits. When you're
not pressing the hotkey, nothing from this project is running: 0% CPU,
0 MB RAM. That's not a tuning goal, it's just how the architecture works.

Usage:
    jarvis --voice          record + transcribe + run
    jarvis --text "prompt"  skip mic, run a typed prompt directly
    jarvis --text-prompt    pop a GUI text box (zenity) to type into
    jarvis --reset          clear any in-progress conversation memory and exit
"""

import argparse
import os
import re
import tempfile
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
from config_loader import CONFIG

import ollama_client
import session
import voice as voice_module

_DEBUG = bool(CONFIG.get("debug"))
_DEBUG_LOG_PATH = "/tmp/jarvis-debug.log"


def _debug(section: str, **fields) -> None:
    """Opt-in debug trail (config.yaml: debug: true). No-op otherwise."""
    if not _DEBUG:
        return
    with open(_DEBUG_LOG_PATH, "a") as f:
        f.write(f"\n--- {section} ---\n")
        for key, value in fields.items():
            f.write(f"{key}={value!r}\n")


def strip_markdown(text: str) -> str:
    text = re.sub(r"\*\*(.+?)\*\*", r"\1", text)
    text = re.sub(r"(?<!\w)\*(.+?)\*(?!\w)", r"\1", text)
    text = re.sub(r"__(.+?)__", r"\1", text)
    text = re.sub(r"(?<!\w)_(.+?)_(?!\w)", r"\1", text)
    text = re.sub(r"`{1,3}(.+?)`{1,3}", r"\1", text)
    text = re.sub(r"^#{1,6}\s*", "", text, flags=re.MULTILINE)
    text = re.sub(r"^\s*[-*+]\s+", "", text, flags=re.MULTILINE)
    return text.strip()


def notify(text: str) -> None:
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Jarvis", "Jarvis", text[:500]])
    print(text)


def notify_transient(text: str, icon: str = "dialog-information") -> None:
    """Short-lived status notification (listening/thinking) that replaces
    itself via a fixed synchronous hint, rather than stacking up notifications."""
    if shutil.which("notify-send"):
        subprocess.run([
            "notify-send", "-a", "Jarvis", "-i", icon,
            "-h", "string:x-canonical-private-synchronous:jarvis-status",
            "-t", "4000", "Jarvis", text,
        ])
    print(text)


def _find_piper() -> str | None:
    project_root = os.path.dirname(
        os.path.dirname(os.path.abspath(__file__))
    )

    candidates = [
        os.path.join(project_root, ".venv", "bin", "piper"),
        shutil.which("piper"),
    ]

    for candidate in candidates:
        if candidate and os.path.exists(candidate):
            return candidate

    return None


def _speak_piper(text: str, piper_bin: str, piper_model: str, volume: str) -> bool:
    """Returns True on success. Falls back to False (caller then tries
    espeak) rather than raising - a missing ffmpeg used to crash the whole
    script here with an unhandled FileNotFoundError."""
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        wav_path = tmp.name

    try:
        subprocess.run(
            [piper_bin, "--model", piper_model, "--output_file", wav_path],
            input=text,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )

        play_path = wav_path
        if shutil.which("ffmpeg"):
            louder_path = wav_path.replace(".wav", "_loud.wav")
            try:
                subprocess.run(
                    ["ffmpeg", "-y", "-i", wav_path, "-filter:a", f"volume={volume}", louder_path],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True,
                )
                play_path = louder_path
            except (subprocess.CalledProcessError, OSError) as e:
                _debug("ffmpeg_volume_failed", error=str(e))
                # play the un-adjusted wav rather than giving up entirely
        else:
            _debug("ffmpeg_missing", note="tts.volume has no effect without ffmpeg installed")

        subprocess.run(["aplay", "-q", play_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        return True
    except (subprocess.CalledProcessError, OSError) as e:
        _debug("piper_failed", error=str(e))
        return False
    finally:
        for p in (wav_path, wav_path.replace(".wav", "_loud.wav")):
            if os.path.exists(p):
                os.unlink(p)


def speak(text: str) -> None:
    tts_cfg = CONFIG.get("tts", {})
    volume = str(tts_cfg.get("volume", 1.0))
    piper_model = tts_cfg.get("piper_model", "")
    engine = tts_cfg.get("engine", "espeak")
    piper_bin = _find_piper()

    _debug("speak", engine=engine, piper_bin=piper_bin, piper_model=piper_model,
           model_exists=os.path.exists(piper_model) if piper_model else False)

    if engine == "piper" and piper_bin and piper_model and os.path.exists(piper_model):
        if _speak_piper(text, piper_bin, piper_model, volume):
            return
        # fall through to espeak below on any piper-path failure

    if shutil.which("espeak-ng"):
        subprocess.run(["espeak-ng", text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif shutil.which("espeak"):
        subprocess.run(["espeak", text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        notify("(no TTS engine available - install espeak-ng, or see README for piper)")


def gui_text_prompt() -> str | None:
    if not shutil.which("zenity"):
        print("zenity not installed - falling back to terminal input.")
        try:
            return input("Jarvis > ")
        except (EOFError, KeyboardInterrupt):
            notify("No terminal input available either - install zenity (see README) to use --text-prompt from a hotkey.")
            return None
    result = subprocess.run(
        ["zenity", "--entry", "--title=Jarvis", "--text=What do you need?"],
        capture_output=True, text=True,
    )
    return result.stdout.strip() or None


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--voice", action="store_true", help="Record mic input")
    mode.add_argument("--text", type=str, help="Run a prompt directly, no mic")
    mode.add_argument("--text-prompt", action="store_true", help="Pop a GUI box to type into")
    mode.add_argument("--reset", action="store_true", help="Clear any in-progress conversation memory and exit")
    parser.add_argument("--speak", action="store_true", help="Speak the response aloud")
    args = parser.parse_args()

    if args.reset:
        session.clear()
        notify("Conversation memory cleared.")
        return

    if args.voice:
        notify_transient("Listening... (speak now)", icon="microphone-sensitivity-high")
        try:
            prompt = voice_module.listen_and_transcribe()
        except FileNotFoundError as e:
            notify(str(e))
            return
        if not prompt:
            notify("Didn't catch anything.")
            return

        if CONFIG.get("voice", {}).get("correction_enabled", True):
            corrected, changed = ollama_client.correct_transcript(prompt)
            if changed:
                notify_transient(
                    f'Heard: "{prompt}" — reads better as: "{corrected}"',
                    icon="system-run",
                )
                prompt = corrected
            else:
                notify_transient(f'Heard: "{prompt}" — thinking...', icon="system-run")
        else:
            notify_transient(f'Heard: "{prompt}" — thinking...', icon="system-run")
    elif args.text_prompt:
        prompt = gui_text_prompt()
        if not prompt:
            return
        notify_transient("Thinking...", icon="system-run")
    else:
        prompt = args.text
        notify_transient("Thinking...", icon="system-run")

    # Confirm-tier actions (close_app, edit_file) can pop a spoken yes/no
    # prompt instead of a GUI dialog - but only when the user actually asked
    # for spoken output (--speak). A bare --voice run without --speak still
    # gets text-only replies, so confirmations shouldn't unilaterally start
    # talking either; they fall back to the GUI/terminal dialog instead.
    speak_confirmations = args.voice and args.speak

    response = ollama_client.run(
        prompt,
        voice=args.voice,
        speak_fn=speak if args.speak else None,
        speak_confirmations=speak_confirmations,
    )
    response = strip_markdown(response)
    notify(response)
    if args.speak:
        speak(response)


if __name__ == "__main__":
    main()